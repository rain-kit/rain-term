{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rain Term",
  "mainBinaryName": "rain-term",
  "version": "1.2.3",
  "identifier": "com.rain-term.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg5OTNGOTIxMTdBQURCNDcKUldSSDI2b1hJZm1UaVNGSTZrTWo0WTJzTGtBM2dKelhXS09qQVdqUndLTEkvYUNKL21rQmNrZXYK",
      "endpoints": ["https://github.com/rain-kit/rain-term/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "dmg", "app", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "SSH / 远程桌面客户端",
    "longDescription": "轻量的 SSH / 远程桌面客户端：多标签终端、Windows 远程桌面、跳板机和 SFTP 文件管理。",
    "category": "DeveloperTool",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
